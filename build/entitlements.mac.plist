<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Droits requis par OxoAI sous « hardened runtime ».
    Le durcissement est obligatoire pour la notarisation Apple.
  -->

  <!-- Electron exécute du code compilé à la volée (moteur JavaScript). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- La passerelle et les serveurs d'outils sont lancés par l'application. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Inférence locale et serveurs MCP : connexions réseau locales. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- L'agent travaille sur les fichiers choisis par l'utilisateur. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!--
    Dictée (bouton micro du composer). À retirer si la fonction n'est pas
    livrée : ne demandez que les droits réellement utilisés.
  -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!--
    Contrôle de l'écran : la saisie clavier passe par « System Events », donc
    par des Apple Events. Sous « hardened runtime », sans ce droit l'envoi est
    refusé, même si l'utilisateur a accordé l'Accessibilité.
    À retirer si computerUse reste sur « desactive » chez tous les clients.
  -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>

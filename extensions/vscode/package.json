{
  "name": "oxoai-ai",
  "displayName": "OxoAI AI",
  "description": "Le Chat de votre instance OxoAI dans VS Code : vos modèles, sur votre machine ou celle de votre entreprise.",
  "version": "0.2.6",
  "publisher": "oxoai",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinleonardcyber-ops/oxoai"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oxoai",
          "title": "OxoAI AI",
          "icon": "media/oxoai.svg"
        }
      ]
    },
    "views": {
      "oxoai": [
        {
          "type": "webview",
          "id": "oxoai.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "oxoai.expliquer",
        "title": "OxoAI : expliquer la sélection"
      },
      {
        "command": "oxoai.ameliorer",
        "title": "OxoAI : améliorer la sélection"
      },
      {
        "command": "oxoai.nouveau",
        "title": "OxoAI : nouveau Chat"
      },
      {
        "command": "oxoai.seConnecter",
        "title": "OxoAI : se connecter (pour OxoAI Code)"
      },
      {
        "command": "oxoai.seDeconnecter",
        "title": "OxoAI : se déconnecter"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "oxoai.expliquer",
          "when": "editorHasSelection",
          "group": "oxoai@1"
        },
        {
          "command": "oxoai.ameliorer",
          "when": "editorHasSelection",
          "group": "oxoai@2"
        }
      ]
    },
    "configuration": {
      "title": "OxoAI AI",
      "properties": {
        "oxoai.adresse": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Adresse de l'instance OxoAI. Par défaut, celle de l'application OxoAI de cet ordinateur. Hors de cet ordinateur, en https. Réglable seulement pour la machine, jamais par un espace de travail.",
          "scope": "machine"
        },
        "oxoai.jeton": {
          "type": "string",
          "default": "",
          "description": "Jeton d'instance. Vide : lu dans ~/.oxoai/data/instance-token, pour l'instance de cet ordinateur.",
          "scope": "machine"
        },
        "oxoai.modele": {
          "type": "string",
          "default": "",
          "description": "Modèle à utiliser (identifiant OxoAI). Vide : OxoAI choisit, comme en mode Auto."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "L'extension envoie le fichier ouvert et la sélection à l'instance OxoAI : elle ne s'active que dans un espace de confiance."
    }
  }
}

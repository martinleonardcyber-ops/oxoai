{
  "name": "oxoai-plateforme",
  "nomAffiche": "OxoAI",
  "depotMisesAJour": "martinleonardcyber-ops/oxoai",
  "private": true,
  "version": "2026.1026.2",
  "license": "AGPL-3.0-only",
  "description": "OxoAI : ton espace de travail IA local et open source (dérivé de HelixAI)",
  "desktopName": "oxoai-plateforme.desktop",
  "author": {
    "name": "martinleonardcyber-ops",
    "url": "https://github.com/martinleonardcyber-ops/oxoai"
  },
  "contributors": [
    {
      "name": "Medhi Clabaut (Helix Agence), auteur de HelixAI dont OxoAI est dérivé",
      "url": "https://github.com/medhiclb/HelixAI"
    }
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "oxoai": "cli/oxoai.mjs"
  },
  "scripts": {
    "dev": "vite",
    "gateway": "node gateway/src/index.ts",
    "app": "npm run build:gateway && electron .",
    "package": "npm run build && electron-builder --publish never",
    "build:gateway": "node scripts/modele-application.mjs && esbuild gateway/src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-gateway/index.cjs --external:pg-native && esbuild gateway/tools/motdepasse.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-gateway/motdepasse.cjs --external:pg-native",
    "build": "tsc --noEmit && npm run typecheck:gateway && vite build && npm run build:gateway",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck:gateway",
    "i18n": "node scripts/i18n.mjs",
    "i18n-passerelle": "node scripts/i18n-passerelle.mjs",
    "securite": "node scripts/securite.mjs",
    "essai:cli": "node scripts/essai-cli.mjs",
    "essai:vscode": "node scripts/essai-vscode.mjs",
    "essai:palmier": "node scripts/essai-palmier.mjs",
    "essai:roblox-blender": "node scripts/essai-roblox-blender.mjs",
    "essai:unreal-perso": "node scripts/essai-unreal-perso.mjs",
    "essai:contexte": "node scripts/essai-contexte.mjs",
    "essai:memoire": "node scripts/essai-memoire-conversation.mjs",
    "essai:design": "node --experimental-strip-types scripts/essai-design.mjs",
    "motdepasse": "node --experimental-strip-types gateway/tools/motdepasse.ts",
    "typecheck:gateway": "tsc --noEmit -p tsconfig.gateway.json",
    "package:signe": "node scripts/signature/construire.mjs",
    "cle:editeur": "node scripts/signature/cle-editeur.mjs",
    "verifier:signature": "node scripts/signature/verifier.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "build": {
    "appId": "com.oxoria.oxoai",
    "afterSign": "scripts/signature/signer-mise-a-jour.cjs",
    "afterPack": "scripts/signature/cle-windows.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "copyright": "Copyright © 2026 Medhi Clabaut (HelixAI) et martinleonardcyber-ops (OxoAI) · AGPL-3.0",
    "productName": "OxoAI",
    "protocols": {
      "name": "Invitation OxoAI",
      "schemes": [
        "oxoai"
      ],
      "role": "Viewer"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-gateway/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/icons/512x512.png",
      "build/tray.png",
      "build/tray@2x.png"
    ],
    "extraResources": [
      {
        "from": "dist-gateway",
        "to": "dist-gateway"
      },
      {
        "from": "cli",
        "to": "cli"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "OxoAI pilote le clavier de votre Mac pour réaliser les actions que vous approuvez dans Cowork.",
        "NSSystemAdministrationUsageDescription": "OxoAI a besoin de l'Accessibilité pour déplacer la souris et saisir au clavier, uniquement pour les actions que vous approuvez.",
        "NSMicrophoneUsageDescription": "OxoAI utilise le micro pour la dictée et l'enregistrement des réunions. Le son est transcrit par votre instance, sans service extérieur."
      },
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "synopsis": "Plateforme d'IA locale et souveraine",
      "syncDesktopName": true,
      "icon": "build/icons"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "fr_FR",
        "en_US",
        "zh_CN"
      ],
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "OxoAI-Setup-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libatomic1",
        "libgomp1",
        "libdrm2",
        "libgbm1",
        "libasound2t64 | libasound2"
      ],
      "recommends": [
        "python3",
        "python3-venv",
        "unzip"
      ]
    },
    "toolsets": {
      "appimage": "1.0.3",
      "nsis": "1.2.1"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "title": "OxoAI",
      "background": "build/dmg-fond.tiff",
      "iconSize": 112,
      "iconTextSize": 13,
      "window": {
        "width": 660,
        "height": 436
      },
      "contents": [
        {
          "x": 180,
          "y": 205,
          "type": "file"
        },
        {
          "x": 480,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
